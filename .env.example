# Copy this file to .env in the project root and adjust as needed.
# Every setting here has a sensible default (see backend/app/config.py) --
# you only need to uncomment what you want to change.

# --- Networking ---
# HOST=127.0.0.1
# PORT=8731

# --- Fully local mode ---
# When true: the Anthropic provider and web-page ingestion are both
# disabled, so nothing ever leaves this machine. Embeddings/LLM must use
# "local" / "ollama" in this mode.
# FULLY_LOCAL_MODE=false

# --- Embeddings ---
# EMBEDDING_PROVIDER=local          # local | ollama
# LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- LLM ---
# LLM_PROVIDER=ollama               # ollama | anthropic
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b-instruct    # must already be pulled: `ollama pull <model>`
# ANTHROPIC_API_KEY=                # required if LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Retrieval tuning ---
# USE_RERANKER=true
# CHUNK_TARGET_TOKENS=400
# CHUNK_OVERLAP_TOKENS=60
# REFUSAL_SCORE_THRESHOLD=0.15

# --- OCR ---
# OCR_ENABLED=true
# OCR_LANGUAGES=en

# --- Uploads ---
# MAX_UPLOAD_MB=100
